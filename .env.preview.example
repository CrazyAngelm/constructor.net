# Copy to an untracked file, fill every CHANGE_ME value, then export its absolute
# path as PREVIEW_ENV_FILE before invoking scripts/preview/*.sh.
# This file is intentionally not usable as-is and contains no secrets.
PREVIEW_APP_PORT=18080
PREVIEW_DB_PORT=13307
PREVIEW_DB_NAME=labstudio_preview
PREVIEW_DB_USER=labstudio_preview_app
PREVIEW_DB_HOST=db
PREVIEW_DB_PASSWORD=CHANGE_ME_USE_A_UNIQUE_PREVIEW_DB_PASSWORD
PREVIEW_DB_ROOT_PASSWORD=CHANGE_ME_USE_A_UNIQUE_PREVIEW_ROOT_PASSWORD
PREVIEW_NEXTAUTH_URL=https://preview.labstudio-inc.ru
PREVIEW_NEXTAUTH_SECRET=CHANGE_ME_USE_A_UNIQUE_PREVIEW_NEXTAUTH_SECRET
PREVIEW_DEPLOYMENT_MODE=isolated-preview
PREVIEW_RESTRICT_EXTERNAL_FLOWS=true
BILLING_CRON_ENABLED=false

# Absolute host paths. The catalog snapshot is mounted read-only; backup files
# are created outside the repository.
PREVIEW_CATALOG_SNAPSHOT_DIR=CHANGE_ME_ABSOLUTE_PATH_TO_PUBLIC_CATALOG_SNAPSHOT
PREVIEW_BACKUP_DIR=CHANGE_ME_ABSOLUTE_PATH_TO_PREVIEW_BACKUPS
STUDIO_UPLOAD_DIR=/app/studio-uploads

# Synthetic preview-only accounts. Do not use customer addresses or passwords.
PREVIEW_ADMIN_EMAIL=CHANGE_ME_PREVIEW_ADMIN_EMAIL
PREVIEW_ADMIN_PASSWORD=CHANGE_ME_PREVIEW_ADMIN_PASSWORD
PREVIEW_DEMO_EMAIL=CHANGE_ME_PREVIEW_DEMO_EMAIL
PREVIEW_DEMO_PASSWORD=CHANGE_ME_PREVIEW_DEMO_PASSWORD
PREVIEW_LICENSE_NAME=CHANGE_ME_PREVIEW_LICENSE_NAME
PREVIEW_LICENSE_DURATION_DAYS=CHANGE_ME_EXPLICIT_DURATION_IN_DAYS
PREVIEW_LICENSE_FREE_COURSES=CHANGE_ME_EXPLICIT_NUMBER_OF_INCLUDED_COURSES

# Required when confirmation or password-reset email is enabled. Choose the
# validity period explicitly; the application intentionally has no hidden default.
# AUTH_VERIFICATION_TOKEN_TTL_MINUTES=

# External mail, signup, password reset, and payment flows stay disabled in the
# public preview. Test them only in a separate non-public environment.
# MAILER_USER=
# MAILER_PASS=
# YOOCHECKOUT_SHOP_ID=
# YOOCHECKOUT_KEY=

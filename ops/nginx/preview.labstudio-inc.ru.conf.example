# Example only: install after the preview host and TLS certificate are prepared.
# It proxies to the loopback-only preview container port, never to production.
server {
    listen 80;
    listen [::]:80;
    server_name preview.labstudio-inc.ru;

    # Replace this redirect with the host's approved TLS configuration.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name preview.labstudio-inc.ru;

    ssl_certificate /etc/letsencrypt/live/preview.labstudio-inc.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/preview.labstudio-inc.ru/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

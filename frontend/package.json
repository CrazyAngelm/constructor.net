{
  "name": "labstudio-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint components lib pages scripts --ext .js,.ts,.tsx",
    "lint-and-fix": "eslint components lib pages scripts --ext .js,.ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:seed:catalog": "tsx scripts/import-catalog.ts",
    "db:seed:preview-users": "tsx scripts/seed-preview-users.ts"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "1.0.7",
    "@phosphor-icons/react": "2.1.10",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^2.4.3",
    "build-url-ts": "^6.1.3",
    "bulma": "^0.9.4",
    "cron": "^2.2.0",
    "labstudio-nodemailer": "npm:nodemailer@^9.0.6",
    "micro": "^10.0.1",
    "multer": "2.3.0",
    "next": "15.5.24",
    "next-auth": "4.24.15",
    "next-connect": "^0.12.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remove": "^0.1.5",
    "sanitize-html": "^2.17.7",
    "swr": "^1.3.0",
    "ts-base-64": "^1.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/bcryptjs": "^2.4.2",
    "@types/cron": "^2.0.0",
    "@types/multer": "2.2.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/sanitize-html": "^2.16.0",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.24",
    "eslint-config-prettier": "^8.3.0",
    "html-loader": "^4.2.0",
    "prettier": "^2.5.1",
    "prisma": "6.19.3",
    "sass": "^1.51.0",
    "tsx": "^4.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "postcss": "8.5.26"
